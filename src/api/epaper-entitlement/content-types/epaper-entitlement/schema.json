{
  "kind": "collectionType",
  "collectionName": "epaper_entitlements",
  "info": {
    "singularName": "epaper-entitlement",
    "pluralName": "epaper-entitlements",
    "displayName": "Epaper Entitlement",
    "description": "One access window. scope: personal = a reader's own purchase; org_contract = what an organization has paid for (organization set, user empty); org_member = an Org Admin's grant to one member, which must sit inside an org_contract window. scope is derived in lifecycles.js when the caller doesn't send it, so epaper-transaction needs no changes. A row with revokedAt set grants nothing."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::epaper-user.epaper-user"
    },
    "organization": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::epaper-organization.epaper-organization",
      "inversedBy": "entitlements"
    },
    "plan": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::epaper-plan.epaper-plan"
    },
    "coverageStart": {
      "type": "date",
      "required": true
    },
    "coverageEnd": {
      "type": "date",
      "required": true
    },
    "amountPaid": {
      "type": "biginteger"
    },
    "currency": {
      "type": "string",
      "default": "UGX"
    },
    "transaction": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::epaper-transaction.epaper-transaction",
      "inversedBy": "entitlements"
    },
    "scope": {
      "type": "enumeration",
      "enum": ["personal", "org_contract", "org_member"]
    },
    "grantSource": {
      "type": "enumeration",
      "enum": ["purchase", "org_admin", "import", "handle"]
    },
    "grantedByUser": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::epaper-user.epaper-user"
    },
    "grantedByAdmin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::handle-admin.handle-admin"
    },
    "revokedAt": {
      "type": "datetime"
    },
    "revokedReason": {
      "type": "text"
    },
    "note": {
      "type": "text"
    }
  }
}