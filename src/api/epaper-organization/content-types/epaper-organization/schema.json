{
  "kind": "collectionType",
  "collectionName": "epaper_organizations",
  "info": {
    "singularName": "epaper-organization",
    "pluralName": "epaper-organizations",
    "displayName": "Epaper Organization",
    "description": "A master account (e.g. Parliament of Uganda) paying centrally for named member seats. `status` is the source of truth; `active` is kept in sync by lifecycles.js for any older code still reading it."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "owner": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::epaper-user.epaper-user"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "suspended", "archived"],
      "default": "active"
    },
    "seatLimit": {
      "type": "integer",
      "min": 0
    },
    "contactName": {
      "type": "string"
    },
    "contactEmail": {
      "type": "email"
    },
    "contactPhone": {
      "type": "string"
    },
    "suspendedAt": {
      "type": "datetime"
    },
    "suspendedReason": {
      "type": "text"
    },
    "notes": {
      "type": "text"
    },
    "createdByAdmin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::handle-admin.handle-admin"
    },
    "seats": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::epaper-org-seat.epaper-org-seat",
      "mappedBy": "organization"
    },
    "entitlements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::epaper-entitlement.epaper-entitlement",
      "mappedBy": "organization"
    }
  }
}