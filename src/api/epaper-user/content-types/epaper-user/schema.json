{
  "kind": "collectionType",
  "collectionName": "epaper_users",
  "info": {
    "singularName": "epaper-user",
    "pluralName": "epaper-users",
    "displayName": "Epaper User",
    "description": "The real identity/credential store for epaper readers — replaces plugin::users-permissions.user for this app. passwordHash never leaves this content-type's own controller; see services/epaper-user.js. Users added by an Org Admin are created with an unusable random passwordHash plus a pending invite (inviteTokenHash/inviteExpiresAt), and set their real password through the invite link."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true
    },
    "passwordHash": {
      "type": "string",
      "required": true,
      "private": true
    },
    "displayName": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "tokenVersion": {
      "type": "integer",
      "default": 0,
      "private": true
    },
    "accountSource": {
      "type": "enumeration",
      "enum": ["self_registered", "org_invite", "org_import"]
    },
    "inviteTokenHash": {
      "type": "string",
      "private": true
    },
    "inviteExpiresAt": {
      "type": "datetime",
      "private": true
    },
    "invitedAt": {
      "type": "datetime"
    },
    "passwordSetAt": {
      "type": "datetime"
    }
  }
}